<?xml version="1.0" encoding="UTF-8"?>
<!-- Weekly portfolio allocation. Saturdays 10:30 local (after review 09:00 → reconcile 09:30
     → monitor 10:00 have finalized the gate): across the committee-approved, non-blocked
     pairs, measure how correlated their edges' return streams are and set a diversification-
     aware per-pair risk weight in ~/.quant-desk/registry.json. The daily paper runner sizes
     each position against that weight (a risk-parity-with-correlation-penalty overlay on the
     risk engine — NOT a return optimizer). Read-only research; paper-only system.
     Install:
       cp scripts/com.quantdesk.allocate.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.quantdesk.allocate.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.quantdesk.allocate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/devantipler/quant-desk/.venv/bin/quant-desk</string>
    <string>allocate</string>
    <string>--strategy</string><string>orb,meanrev,vwap,gapfade</string>
    <string>--regime</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/devantipler/quant-desk</string>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/devantipler/quant-desk/allocate.out.log</string>
  <key>StandardErrorPath</key><string>/Users/devantipler/quant-desk/allocate.err.log</string>
</dict>
</plist>
