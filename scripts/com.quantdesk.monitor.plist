<?xml version="1.0" encoding="UTF-8"?>
<!-- Weekly edge-decay monitor. Saturdays 10:00 local: re-assess each symbol's rolling
     out-of-sample health across the basket and update ~/.quant-desk/registry.json. The
     daily paper runner (paper-run --select) then auto-excludes any symbol the monitor has
     retired. Read-only research; paper-only system.
     Install:
       cp scripts/com.quantdesk.monitor.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.quantdesk.monitor.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.quantdesk.monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/devantipler/quant-desk/.venv/bin/quant-desk</string>
    <string>monitor</string>
    <string>--strategy</string><string>orb,meanrev,vwap,gapfade</string>
    <string>--regime</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/devantipler/quant-desk</string>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/devantipler/quant-desk/monitor.out.log</string>
  <key>StandardErrorPath</key><string>/Users/devantipler/quant-desk/monitor.err.log</string>
</dict>
</plist>
